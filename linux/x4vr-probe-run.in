#!/usr/bin/env bash
# Phase 0 probe launcher (docs/LINUX_PHASE0.md). Use it as X4's Steam launch option:
#
#   /full/path/to/x4vr-probe-run %command%
#
# It loads the socket probe (libx4vr_probe.so) and the logging Vulkan layer (VK_LAYER_X4VR_probe)
# into X4. Both only write logs to $X4VR_PROBE_DIR (default ~/.local/state/x4vr/probe); the game
# runs unchanged. Remove the launch option to go back to a normal start.
set -u
if [ $# -eq 0 ]; then
    echo "usage: x4vr-probe-run <game command>   (Steam launch option: x4vr-probe-run %command%)" >&2
    exit 2
fi
dir="${X4VR_PROBE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/x4vr/probe}"
mkdir -p "$dir"
export X4VR_PROBE_DIR="$dir"
export LD_PRELOAD="@CMAKE_INSTALL_FULL_LIBDIR@/libx4vr_probe.so${LD_PRELOAD:+:$LD_PRELOAD}"
export VK_ADD_LAYER_PATH="@CMAKE_INSTALL_FULL_DATADIR@/vulkan/explicit_layer.d${VK_ADD_LAYER_PATH:+:$VK_ADD_LAYER_PATH}"
export VK_INSTANCE_LAYERS="VK_LAYER_X4VR_probe${VK_INSTANCE_LAYERS:+:$VK_INSTANCE_LAYERS}"
export VK_LOADER_LAYERS_ENABLE="VK_LAYER_X4VR_probe${VK_LOADER_LAYERS_ENABLE:+,$VK_LOADER_LAYERS_ENABLE}"
export VK_LOADER_DEBUG="${VK_LOADER_DEBUG:-error,warn,layer}"
{
    echo "== $(date '+%F %T') x4vr-probe-run (pid $$)"
    echo "command: $*"
    for name in LD_PRELOAD VK_ADD_LAYER_PATH VK_INSTANCE_LAYERS VK_LOADER_LAYERS_ENABLE VK_LAYER_PATH XDG_SESSION_TYPE; do
        echo "$name=${!name-}"
    done
} >> "$dir/wrapper.log"
# The loader's messages (did the layer load?) and anything else on stderr go to stderr.log.
exec "$@" 2>> "$dir/stderr.log"
